# Python bytecode and interpreter/test caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Local Python environments and packaging output
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Local secrets and machine-specific configuration
.env
.env.*
!.env.example

# Editors, office lock files, and operating-system metadata
.DS_Store
Thumbs.db
.~lock.*#
*.swp
*.swo
*~

# DDL source files are large, separately downloaded, and governed by DDL terms.
# Keep datasetddl/README.md in the repository; place downloaded CSVs under csv/.
datasetddl/csv/
datasetddl/dta/

# Regenerated case-level cohorts, feature tables, and prediction files can be
# several GB and contain case identifiers. Rebuild them with codebase/run_pipeline.sh.
result/data/*
!result/data/README.md
!result/data/.gitkeep

# Serialized estimators are generated binary artifacts; reproduce from source.
result/models/*
!result/models/README.md
!result/models/.gitkeep

# Logs and temporary files
*.log
*.tmp

# Fresh publish history prepared alongside the read-only original .git
.git-publish/
